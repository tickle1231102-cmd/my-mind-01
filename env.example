# ── Vercel AI Gateway (권장) ─────────────────────────────────
# OIDC(OAuth) 방식: Vercel 프로젝트 링크 후 env pull 하면
# VERCEL_OIDC_TOKEN 이 자동으로 들어갑니다.
#
#   vercel link
#   vercel env pull .env.local
#
# 대시보드에서 AI Gateway를 켠 뒤 배포하면 프로덕션에서도
# OIDC 토큰이 자동 갱신되어 채팅 AI가 동작합니다.
#
# 로컬/CI에서 OIDC 대신 고정 키를 쓰려면:
# AI_GATEWAY_API_KEY=••••••••••••••••••••••••••••••••
#
# 모델 (provider/model 형식, 기본 google/gemini-2.5-flash)
# AI_GATEWAY_MODEL=google/gemini-2.5-flash


# ── Legacy: Google AI Studio 직접 키 (Gateway 없을 때 폴백) ──
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=•••••••••••••••••••••••••••••••••••••••••••••••••••••
# GEMINI_MODEL=gemini-2.0-flash
